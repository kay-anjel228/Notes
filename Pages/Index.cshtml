@page
@model StudyNoteProject.Pages.Shared.IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-warning">
                    @Model.Message
                </div>
            }
            @if (Model.IsAuthorized)
            {
                <div class="card shadow">
                    <div class="card-body text-center">
                        <h2 class="mb-3">Здравствуйте, @Model.CurrentUserName (@Model.CurrentUserLogin).</h2>
                        <p class="text-muted">
                            Вы успешно вошли в аккаунт
                        </p>

                        <div class="d-flex justify-content-center gap-2 mb-3">
                            <a asp-page="/MyNotes" class="btn btn-outline-primary">Мои записи</a>
                        </div>

                        <form method="post" asp-page-handler="Logout">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                Выйти
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow">
                    <div class="card-body">
                        <h2 class="text-center mb-4">Добро пожаловать</h2>
                        <ul class="nav nav-tabs mb-3" id="authTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active"
                                        id="login-tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#login"
                                        type="button"
                                        role="tab">
                                    Вход
                                </button>
                            </li>

                            <li class="nav-item" role="presentation">
                                <button class="nav-link"
                                        id="register-tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#register"
                                        type="button"
                                        role="tab">
                                    Регистрация
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="login" role="tabpanel">
                                <form method="post" asp-page-handler="Login">
                                    <div class="mb-3">
                                        <label class="form-label">Логин</label>
                                        <input asp-for="LoginLogin" class="form-control" required />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Пароль</label>
                                        <div class="input-group mb-3">
                                            <input id="loginPassword"
                                                   asp-for="LoginPassword"
                                                   type="password"
                                                   class="form-control" required />

                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    onclick="togglePassword('loginPassword', this)">
                                                Показать
                                            </button>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">Войти</button>
                                </form>
                            </div>

                            <div class="tab-pane fade" id="register" role="tabpanel">
                                <form method="post" asp-page-handler="Register">
                                    <div class="mb-3">
                                        <label class="form-label">Имя</label>
                                        <input asp-for="RegisterName" class="form-control" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Логин</label>
                                        <input asp-for="RegisterLogin" class="form-control" required />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Пароль</label>
                                        <input asp-for="RegisterPassword" type="password" class="form-control" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Повторите пароль</label>
                                        <input asp-for="RegisterRepeatPassword" type="password" class="form-control" required />
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">
                                        Зарегистрироваться
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
