@page
@model StudyNoteProject.Pages.AddNotesModel
@{
    ViewData["Title"] = Model.PageTitle;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 card p-4 border shadow-sm">

            <h2 class="mb-4 text-center">@Model.PageTitle</h2>

            <form method="post">
                <input type="hidden" asp-for="NoteForm.Id" />
                <input type="hidden" asp-for="NoteForm.AuthorId" />
                <input type="hidden" asp-for="NoteForm.CreatedAt" />

                <div class="mb-3">
                    <label class="form-label"><b>Предмет:</b></label>
                    <input type="text" asp-for="NoteForm.Title" class="form-control" placeholder="Школьный предмет" required />
                </div>

                <div class="mb-3">
                    <label class="form-label"><b>Категория работы:</b></label>
                    <select asp-for="NoteForm.Category" class="form-select" required>
                        <option value="">Выберите категорию</option>
                        <option value="Домашняя работа">Домашняя работа</option>
                        <option value="Проект">Проект</option>
                        <option value="Лабораторная работа">Лабораторная работа</option>
                        <option value="Конспект урока">Конспект урока</option>
                        <option value="Другое">Другое</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label"><b>Описание заметки:</b></label>
                    <textarea asp-for="NoteForm.Description" class="form-control" rows="6" placeholder="Введите описание вашей заметки" required></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success w-100">Сохранить</button>
                    <a asp-page="/MyNotes" class="btn btn-danger w-100">Отмена</a>
                </div>
            </form>

        </div>
    </div>
</div>